# NextGen Sportsbook — local development only
# Copy to .env and fill values. Never commit real secrets.

NODE_ENV=development

# Customer / Admin / Agent Next.js apps
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081/api/v1
NEXT_PUBLIC_APP_ENV=mock

# Laravel API (apps/api)
APP_NAME="NextGen Sportsbook"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nextgen_sportsbook
DB_USERNAME=nextgen
DB_PASSWORD=nextgen_dev_only

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# All money and sports feeds are mock/sandbox until approved.
PAYMENTS_MODE=sandbox
SPORTS_DATA_MODE=mock

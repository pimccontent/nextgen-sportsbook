{
  "name": "nextgen-sportsbook",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:customer": "pnpm --filter @nextgen/customer dev",
    "dev:admin": "pnpm --filter @nextgen/admin dev",
    "dev:agent": "pnpm --filter @nextgen/agent dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}

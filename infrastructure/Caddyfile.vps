# Path layout (default): apex hosts customer + /agent + /api (+ /storage).
# Admin stays on admin.{$DOMAIN}.
# Legacy four-host layout: use Caddyfile.vps.hosts instead (URL_LAYOUT=hosts).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	# Laravel API + public storage (APP_URL = https://DOMAIN)
	handle /api* {
		reverse_proxy api:8080
	}
	handle /storage* {
		reverse_proxy api:8080
	}
	handle /up {
		reverse_proxy api:8080
	}

	# Agent portal (Next basePath=/agent)
	handle /agent* {
		reverse_proxy agent:3000
	}

	# Customer sportsbook
	handle {
		reverse_proxy customer:3000
	}
}

admin.{$DOMAIN} {
	encode gzip
	reverse_proxy admin:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

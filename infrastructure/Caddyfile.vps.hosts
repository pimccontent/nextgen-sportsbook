# Legacy four-hostname layout (URL_LAYOUT=hosts).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip
	reverse_proxy customer:3000
}

admin.{$DOMAIN} {
	encode gzip
	reverse_proxy admin:3000
}

agent.{$DOMAIN} {
	encode gzip
	reverse_proxy agent:3000
}

api.{$DOMAIN} {
	encode gzip
	reverse_proxy api:8080
}

# Copy to repo root as `.env.vps` (install-vps.sh / setup-wizard.sh do this).
#
# HTTPS path layout (default, URL_LAYOUT=path):
#   DNS A → VPS IP:  DOMAIN , admin.DOMAIN
#   Customer  https://DOMAIN/
#   Agent     https://DOMAIN/agent
#   API       https://DOMAIN/api/v1
#   Admin     https://admin.DOMAIN
#
# Legacy four-host layout: URL_LAYOUT=hosts (also needs agent.DOMAIN + api.DOMAIN).
# IP-only (no HTTPS): leave DOMAIN empty and set HOST to the VPS public IP.

DOMAIN=
ACME_EMAIL=ops@example.com
HOST=YOUR_VPS_IP_OR_DOMAIN
URL_LAYOUT=path

POSTGRES_DB=nextgen_sportsbook
POSTGRES_USER=nextgen
POSTGRES_PASSWORD=change_me_to_a_long_secret

APP_ENV=production
APP_DEBUG=false

# Filled automatically by vps-up.sh when DOMAIN is set (HTTPS).
APP_URL=http://YOUR_VPS_IP_OR_DOMAIN:8081
CORS_ALLOWED_ORIGINS=http://YOUR_VPS_IP_OR_DOMAIN:3000,http://YOUR_VPS_IP_OR_DOMAIN:3001,http://YOUR_VPS_IP_OR_DOMAIN:3002

# Public portal URLs (Admin Deploy panel + docs). Filled by vps-up.sh.
DEPLOY_CUSTOMER_URL=http://YOUR_VPS_IP_OR_DOMAIN:3000
DEPLOY_ADMIN_URL=http://YOUR_VPS_IP_OR_DOMAIN:3001
DEPLOY_AGENT_URL=http://YOUR_VPS_IP_OR_DOMAIN:3002
DEPLOY_API_URL=http://YOUR_VPS_IP_OR_DOMAIN:8081/api/v1

API_PORT=8081
CUSTOMER_PORT=3000
ADMIN_PORT=3001
AGENT_PORT=3002

# Baked into Next.js at build time — must match what browsers will call.
NEXT_PUBLIC_API_BASE_URL=http://YOUR_VPS_IP_OR_DOMAIN:8081/api/v1
NEXT_PUBLIC_CUSTOMER_ORIGIN=http://YOUR_VPS_IP_OR_DOMAIN:3000
# Agent path prefix on apex (path layout only). Leave empty for IP / hosts layout.
NEXT_PUBLIC_BASE_PATH=

# Optional prebuilt images (skip long --build). Example:
#   IMAGE_PREFIX=ghcr.io/pimccontent
#   USE_PREBUILT_IMAGES=1
IMAGE_PREFIX=ghcr.io/pimccontent
USE_PREBUILT_IMAGES=0
IMAGE_TAG=latest

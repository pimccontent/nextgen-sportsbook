# Copy to repo root as `.env.vps` (install-vps.sh does this automatically).
#
# HTTPS (recommended): set DOMAIN + ACME_EMAIL and point DNS A records before install:
#   DOMAIN            → customer
#   admin.DOMAIN      → admin
#   agent.DOMAIN      → agent
#   api.DOMAIN        → api
#
# IP-only (no HTTPS): leave DOMAIN empty and set HOST to the VPS public IP.

DOMAIN=
ACME_EMAIL=ops@example.com
HOST=YOUR_VPS_IP_OR_DOMAIN

POSTGRES_DB=nextgen_sportsbook
POSTGRES_USER=nextgen
POSTGRES_PASSWORD=change_me_to_a_long_secret

APP_ENV=production
APP_DEBUG=false

# Filled automatically by vps-up.sh when DOMAIN is set (HTTPS).
APP_URL=http://YOUR_VPS_IP_OR_DOMAIN:8081
CORS_ALLOWED_ORIGINS=http://YOUR_VPS_IP_OR_DOMAIN:3000,http://YOUR_VPS_IP_OR_DOMAIN:3001,http://YOUR_VPS_IP_OR_DOMAIN:3002

API_PORT=8081
CUSTOMER_PORT=3000
ADMIN_PORT=3001
AGENT_PORT=3002

# Baked into Next.js at build time — must match what browsers will call.
NEXT_PUBLIC_API_BASE_URL=http://YOUR_VPS_IP_OR_DOMAIN:8081/api/v1
NEXT_PUBLIC_CUSTOMER_ORIGIN=http://YOUR_VPS_IP_OR_DOMAIN:3000

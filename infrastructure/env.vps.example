# Copy to repo root as `.env.vps` then run: bash scripts/vps-up.sh
# Replace HOST with your VPS public IP or domain (no trailing slash).

HOST=YOUR_VPS_IP_OR_DOMAIN

POSTGRES_DB=nextgen_sportsbook
POSTGRES_USER=nextgen
POSTGRES_PASSWORD=change_me_to_a_long_secret

APP_ENV=production
APP_DEBUG=false
APP_URL=http://${HOST}:8081

API_PORT=8081
CUSTOMER_PORT=3000
ADMIN_PORT=3001
AGENT_PORT=3002

# Baked into Next.js at build time — must match what browsers will call.
NEXT_PUBLIC_API_BASE_URL=http://${HOST}:8081/api/v1
NEXT_PUBLIC_CUSTOMER_ORIGIN=http://${HOST}:3000
